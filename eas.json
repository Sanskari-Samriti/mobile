{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "staging": {
      "channel": "staging",
      "environment": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "ios": { "distribution": "store" }
    },
    "production": {
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "YOUR_NUMERIC_APP_STORE_CONNECT_APP_ID"
      }
    },
    "production": {}
  }
}
